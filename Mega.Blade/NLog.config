<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" >

	<!-- the targets to write to -->
	<targets>

		<!--单个文件过大会导致写入效率下降，可配置单个文件的最大容量-->
		<target name="DebugFile" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
			<target xsi:type="File"
                    fileName="${basedir}/logs/Debug/${shortdate}.log"
                    layout="${longdate} ${newline} 【日志等级】：${level:uppercase=true} ${newline} 【日志类】：${logger} ${newline} 【日志信息】： ${message} ${exception:format=tostring} ${newline} 【url】：${aspnet-request-url} ${newline} 【方法】：${aspnet-mvc-action} ${newline} 【方法地址】：${callsite} ${newline} 【异常堆栈】： ${stacktrace} ${newline} ----------------------------------------------------${newline}"
                    archiveAboveSize="1024000"
                    archiveEvery="Day"
                    />
		</target>
		<target name="InfoFile" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
			<target xsi:type="File"
                    fileName="${basedir}/logs/Info/${shortdate}.log"
                    layout="${longdate} ${newline} 【日志等级】：${level:uppercase=true} ${newline} 【日志类】：${logger} ${newline} 【日志信息】： ${message} ${exception:format=tostring} ${newline} 【url】：${aspnet-request-url} ${newline} 【方法】：${aspnet-mvc-action} ${newline} 【方法地址】：${callsite} ${newline} 【异常堆栈】： ${stacktrace} ${newline} ----------------------------------------------------${newline}"
                    archiveAboveSize="1024000"
                    archiveEvery="Day"
                    />
		</target>
		<target name="WarnFile" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
			<target xsi:type="File"
                    fileName="${basedir}/logs/Warn/${shortdate}.log"
                    layout="${longdate} ${newline} 【日志等级】：${level:uppercase=true} ${newline} 【日志类】：${logger} ${newline} 【日志信息】： ${message} ${exception:format=tostring} ${newline} 【url】：${aspnet-request-url} ${newline} 【方法】：${aspnet-mvc-action} ${newline} 【方法地址】：${callsite} ${newline} 【异常堆栈】： ${stacktrace} ${newline} ----------------------------------------------------${newline}"
                    archiveAboveSize="1024000"
                    archiveEvery="Day"
                    />
		</target>
		<target name="ErrorFile" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
			<target xsi:type="File"
                    fileName="${basedir}/logs/Error/${shortdate}.log"
                    layout="${longdate} ${newline} 【日志等级】：${level:uppercase=true} ${newline} 【日志类】：${logger} ${newline} 【日志信息】： ${message} ${exception:format=tostring} ${newline} 【url】：${aspnet-request-url} ${newline} 【方法】：${aspnet-mvc-action} ${newline} 【方法地址】：${callsite} ${newline} 【异常堆栈】： ${stacktrace} ${newline} ----------------------------------------------------${newline}"
                    archiveAboveSize="1024000"
                    archiveEvery="Day"
                    />
		</target>
	</targets>

	<!-- rules to map from logger name to target -->
	<rules>
		<!--<logger name="*" levels="Debug,Info,Warn,Error" writeTo="File" />-->
		<!--<logger name="Microsoft.*" final="true" />-->
		<logger name="Mega.*" level="Warn" writeTo="WarnFile" />
		<logger name="Mega.*" level="Debug" writeTo="DebugFile" />
		<logger name="Mega.*" level="Info" writeTo="InfoFile" />
		<logger name="Mega.*" level="Error" writeTo="ErrorFile" />
	</rules>
</nlog>
