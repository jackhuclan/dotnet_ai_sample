<Window x:Class="MegaAgent.App.SkillEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:MegaAgent.App"
        Title="编辑技能"
        Width="660" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">
    <hc:Card Margin="18" Padding="4">
        <Grid Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,6" Style="{StaticResource FormLabel}">
                <Run Text="技能名称" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:TextBox Grid.Row="1" x:Name="NameBox"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        local:RequiredBorder.HasError="{Binding NameHasError}"
                        hc:InfoElement.Placeholder="例如：翻译助手" />
            <TextBlock Grid.Row="2" Text="技能名称为必填项"
                       Style="{StaticResource FieldError}"
                       Visibility="{Binding NameHasError, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}">
                <Run Text="技能描述" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:TextBox Grid.Row="4" x:Name="DescBox"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        local:RequiredBorder.HasError="{Binding DescriptionHasError}"
                        hc:InfoElement.Placeholder="一句话说明技能用途" />
            <TextBlock Grid.Row="5" Text="技能描述为必填项"
                       Style="{StaticResource FieldError}"
                       Visibility="{Binding DescriptionHasError, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="6" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}">
                    <Run Text="系统提示词（System Prompt）" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
                <hc:TextBox Grid.Row="1"
                            x:Name="PromptBox"
                            Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            local:RequiredBorder.HasError="{Binding PromptHasError}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            Padding="6,4"
                            hc:InfoElement.Placeholder="作为 system prompt 注入模型，例如：你是一名专业翻译……" />
                <TextBlock Grid.Row="2" Text="系统提示词为必填项"
                           Style="{StaticResource FieldError}"
                           Visibility="{Binding PromptHasError, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="保存" MinWidth="76" Margin="0,0,8,0"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}" />
                <Button Content="取消"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </hc:Card>
</Window>
