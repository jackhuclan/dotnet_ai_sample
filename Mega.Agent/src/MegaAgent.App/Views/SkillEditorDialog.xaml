<Window x:Class="MegaAgent.App.SkillEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑技能"
        Width="660" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">
    <hc:Card Margin="18" Padding="4">
        <Grid Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,6" Style="{StaticResource FormLabel}">
                <Run Text="技能名称" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:TextBox Grid.Row="1" x:Name="NameBox" hc:InfoElement.Placeholder="例如：翻译助手" />
            <TextBlock Grid.Row="2" x:Name="NameError" Style="{StaticResource FieldError}" />

            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}">
                <Run Text="技能描述" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:TextBox Grid.Row="4" x:Name="DescBox" hc:InfoElement.Placeholder="一句话说明技能用途" />
            <TextBlock Grid.Row="5" x:Name="DescError" Style="{StaticResource FieldError}" />

            <Grid Grid.Row="6" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}">
                    <Run Text="系统提示词（System Prompt）" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
                <hc:TextBox Grid.Row="1"
                            x:Name="PromptBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            Padding="6,4"
                            hc:InfoElement.Placeholder="作为 system prompt 注入模型，例如：你是一名专业翻译……" />
                <TextBlock Grid.Row="2" x:Name="PromptError" Style="{StaticResource FieldError}" />
            </Grid>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="保存" MinWidth="76" Margin="0,0,8,0"
                        Style="{StaticResource ButtonPrimary}"
                        Click="SaveButton_Click" />
                <Button Content="取消"
                        Style="{StaticResource ButtonDefault}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </hc:Card>
</Window>
