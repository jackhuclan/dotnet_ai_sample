<Window x:Class="MegaAgent.App.SkillsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="技能管理"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource Brush.Window}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="技能库" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="技能是一段系统提示词（system prompt），在对话中随消息一起注入模型。"
                       Margin="0,5,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="SkillList"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="SkillList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="{Binding Description}" Margin="0,2,0,0"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Prompt}" Margin="0,4,0,0"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="新建技能" Margin="0,0,8,0"
                    Click="AddButton_Click" Style="{StaticResource PrimaryButton}" />
            <Button Content="编辑" Margin="0,0,8,0"
                    Click="EditButton_Click" Style="{StaticResource SecondaryButton}" />
            <Button Content="删除" Margin="0,0,8,0"
                    Click="DeleteButton_Click" Style="{StaticResource DangerButton}" />
            <Button Content="关闭" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </Grid>
</Window>
