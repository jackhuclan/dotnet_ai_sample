<Window x:Class="MegaAgent.App.SkillsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="技能管理"
        Width="660" Height="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="技能库" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="技能是一段系统提示词，对话中输入 / 即可快速选用。"
                       Margin="0,5,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap" />
        </StackPanel>

        <hc:Card Grid.Row="1" Padding="6">
            <ListBox x:Name="SkillList"
                     ItemsSource="{Binding Skills}"
                     SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- 双击条目 = 编辑（走命令，无需代码后置） -->
                <ListBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding Description}" Margin="0,2,0,0"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Prompt}" Margin="0,4,0,0"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource ThirdlyTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </hc:Card>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="新建技能" Margin="0,0,8,0"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding AddCommand}" />
            <Button Content="编辑" Margin="0,0,8,0"
                    Style="{StaticResource ButtonDefault}"
                    Command="{Binding EditCommand}" />
            <Button Content="删除" Margin="0,0,8,0"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding DeleteCommand}" />
            <Button Content="关闭"
                    Style="{StaticResource ButtonDefault}"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
