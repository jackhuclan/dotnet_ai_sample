<Window x:Class="MegaAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MegaAgent.App.Converters"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:vm="clr-namespace:MegaAgent.App.ViewModels"
        Title="MegaAgent"
        Height="800" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- ========== 消息气泡 ========== -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="0,7">
                <Border x:Name="Bubble"
                        MaxWidth="420"
                        Padding="14,10"
                        CornerRadius="8"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource RegionBrush}">
                    <Grid>
                        <!-- 用户消息：纯文本 -->
                        <TextBlock x:Name="PlainText"
                                   Text="{Binding Rendered}"
                                   TextWrapping="Wrap"
                                   LineHeight="21"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <!-- 助手消息：Markdown 渲染 -->
                        <md:MarkdownScrollViewer x:Name="MdView"
                                                 Markdown="{Binding Rendered}"
                                                 Style="{StaticResource MdViewer}"
                                                 Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="MdView" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PlainText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <!-- 用户消息：蓝底白字 -->
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubbleBackground}" />
                    <Setter TargetName="PlainText" Property="Foreground" Value="{StaticResource UserBubbleForeground}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ========== 会话列表项：右侧「…」= 删除 / 重命名 ========== -->
        <DataTemplate x:Key="ConversationTemplate" DataType="{x:Type vm:ConversationViewModel}">
            <Grid>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名" Click="ContextRename_Click" />
                        <Separator />
                        <MenuItem Header="删除对话" Click="ContextDelete_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 常规展示 -->
                <StackPanel x:Name="NormalPanel" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding ModelId}"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- 重命名：原地变文本框，默认全选 -->
                <TextBox x:Name="RenameBox"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         Height="28"
                         Padding="6,3"
                         VerticalContentAlignment="Center"
                         Text="{Binding RenameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Background="{DynamicResource RegionBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         IsVisibleChanged="RenameBox_IsVisibleChanged"
                         PreviewKeyDown="RenameBox_PreviewKeyDown"
                         LostKeyboardFocus="RenameBox_LostKeyboardFocus" />

                <!-- 「…」更多操作 -->
                <Button x:Name="MoreButton"
                        Grid.Column="1"
                        Width="26" Height="26"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="更多操作"
                        Style="{StaticResource GhostIconButton}"
                        PreviewMouseLeftButtonDown="ConversationMore_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ConversationMore_PreviewMouseLeftButtonUp"
                        Click="ConversationMore_Click">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Margin="1.5,0" Fill="{DynamicResource SecondaryTextBrush}" />
                        <Ellipse Width="3" Height="3" Margin="1.5,0" Fill="{DynamicResource SecondaryTextBrush}" />
                        <Ellipse Width="3" Height="3" Margin="1.5,0" Fill="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="NormalPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="MoreButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ========== 斜杠技能浮层项：名称在左、说明在右 ========== -->
        <DataTemplate x:Key="SkillPopupTemplate" DataType="{x:Type vm:SkillPopupItem}">
            <Button x:Name="ItemBtn"
                    HorizontalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource MenuItemButton}"
                    Command="{Binding DataContext.SelectSkillFromPopupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Description}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Description}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="ItemBtn" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootLayout">

        <!-- ==================== 聊天区（始终占满整个窗口） ==================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：展开侧栏 + 标题 + 生成状态 + 头像 -->
            <Border Grid.Row="0"
                    Height="52"
                    Padding="8,0,10,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="0"
                            Content="☰"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            ToolTip="展开/收起会话列表"
                            Style="{StaticResource GhostIconButton}"
                            Click="ToggleSidebar_Click" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentConversation.Title, TargetNullValue=新对话}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <hc:LoadingCircle Width="16" Height="16"
                                          Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="生成中…" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>

                    <!-- 用户头像（矢量绘制，非文字） -->
                    <Border x:Name="TopAvatarButton"
                            Grid.Column="3"
                            Width="30" Height="30"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="用户菜单"
                            MouseLeftButtonUp="AvatarButton_Click">
                        <Grid Width="30" Height="30">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.6">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C9BF7" Offset="0" />
                                        <GradientStop Color="#3B5BDB" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="30" Height="30">
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="6.6"
                                             Width="9" Height="9" Fill="#FFFFFF" Opacity="0.95" />
                                    <Path Fill="#FFFFFF" Opacity="0.95"
                                          Data="M15,17.4 C10.3,17.4 6.7,20.3 5.9,24.5 L24.1,24.5 C23.3,20.3 19.7,17.4 15,17.4 Z" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 消息区 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="18,14"
                              PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding CurrentConversation.Messages}"
                                  ItemTemplate="{StaticResource MessageTemplate}" />
                </ScrollViewer>

                <!-- 空状态 -->
                <hc:Empty VerticalAlignment="Center" HorizontalAlignment="Center"
                          Description="还没有消息，输入内容开始对话吧"
                          Visibility="{Binding CurrentConversation.Messages.Count, Converter={StaticResource CountToVis}}" />

                <!-- 无会话状态 -->
                <hc:Empty VerticalAlignment="Center" HorizontalAlignment="Center"
                          Description="点击左上角「☰」打开会话列表开始"
                          Visibility="{Binding CurrentConversation, Converter={StaticResource NullToVis}}" />

                <!-- 斜杠技能浮层 -->
                <hc:Card VerticalAlignment="Bottom"
                         HorizontalAlignment="Left"
                         Margin="18,0,0,10"
                         Width="392"
                         MaxHeight="280"
                         Padding="6"
                         Effect="{DynamicResource EffectShadow2}"
                         Visibility="{Binding IsSkillPopupOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="选择技能" Margin="8,4,8,6"
                                   Style="{StaticResource HintText}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SkillPopupItems}"
                                          ItemTemplate="{StaticResource SkillPopupTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </hc:Card>
            </Grid>

            <!-- 输入区 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,12"
                    Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 已选技能 chip -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Padding="10,4"
                            CornerRadius="4"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            Visibility="{Binding HasActiveSkill, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveSkillName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Button Content="✕"
                                    Width="20" Height="20"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    FontSize="10"
                                    VerticalAlignment="Center"
                                    ToolTip="取消技能"
                                    Style="{StaticResource GhostIconButton}"
                                    Command="{Binding ClearSkillCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 输入框 -->
                    <hc:TextBox Grid.Row="1"
                                x:Name="InputBox"
                                Text="{Binding DraftInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                hc:InfoElement.Placeholder="今天帮你做些什么?@添加上下文，/调用技能与指令"
                                VerticalContentAlignment="Top"
                                Padding="6,4"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="76"
                                MaxHeight="170"
                                VerticalScrollBarVisibility="Auto"
                                IsEnabled="{Binding HasCurrentConversation}"
                                PreviewKeyDown="InputBox_PreviewKeyDown" />

                    <!-- 底部工具条：模型 + 提示 + 操作 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <hc:ComboBox Grid.Column="0"
                                     Width="150"
                                     Style="{StaticResource ComboBoxExtend}"
                                     IsEditable="False"
                                     ItemsSource="{Binding AvailableModels}"
                                     SelectedItem="{Binding CurrentConversation.ModelId, Mode=TwoWay}"
                                     ToolTip="选择模型"
                                     IsEnabled="{Binding HasCurrentConversation}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   LineHeight="16"
                                   Style="{StaticResource HintText}">
                            <Run Text="Enter 发送" /><LineBreak />
                            <Run Text="Enter+Shift 输入多行信息" />
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="停止"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding StopCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Content="发送"
                                    MinWidth="68"
                                    Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding SendMessageCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 会话抽屉（悬浮覆盖聊天区 50% 宽度） ==================== -->
        <Grid x:Name="SidebarLayer"
              ClipToBounds="True"
              Visibility="Collapsed">
            <!-- 半透明遮罩：点击关闭 -->
            <Border x:Name="SidebarScrim"
                    Background="#4D000000"
                    Opacity="0"
                    MouseLeftButtonDown="SidebarScrim_Click" />

            <!-- 抽屉本体 -->
            <Border x:Name="SidebarDrawer"
                    Width="216"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerTransform" />
                </Border.RenderTransform>
                <DockPanel>

                    <!-- 顶部：新建对话 + 收起（无品牌区） -->
                    <Grid DockPanel.Dock="Top" Margin="14,14,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="新建对话"
                                Height="34"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding NewConversationCommand}" />
                        <Button Grid.Column="1"
                                Content="«"
                                Width="34" Height="34"
                                Margin="6,0,0,0"
                                ToolTip="收起会话列表"
                                Style="{StaticResource GhostIconButton}"
                                Click="ToggleSidebar_Click" />
                    </Grid>

                    <!-- 历史对话标题 -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="历史对话"
                               Margin="16,0,0,4"
                               Style="{StaticResource HintText}" />

                    <!-- 会话列表 -->
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                             ItemTemplate="{StaticResource ConversationTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="6,0,6,8"
                             Padding="2"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <!-- 让「…」贴到行右缘，而不是紧跟文字 -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 会话「…」下拉菜单 ==================== -->
        <Popup x:Name="ConversationMenu"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="150"
                    Margin="8"
                    Padding="5"
                    CornerRadius="10"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{DynamicResource EffectShadow2}">
                <StackPanel>
                    <Button hc:BorderElement.CornerRadius="7"
                            Style="{StaticResource MenuItemButton}"
                            Click="MenuRename_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- 铅笔（编辑） -->
                            <Path Width="15" Height="15"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Data="M17,3 A2.83,2.83 0 1 1 21,7 L7.5,20.5 L2,22 L3.5,16.5 Z"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="重命名"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button hc:BorderElement.CornerRadius="7"
                            Style="{StaticResource MenuItemButton}"
                            Click="MenuDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- 垃圾桶 -->
                            <Path Width="15" Height="15"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Data="M3,6 L21,6 M19,6 L19,20 A2,2 0 0 1 17,22 L7,22 A2,2 0 0 1 5,20 L5,6 M8,6 L8,4 A2,2 0 0 1 10,2 L14,2 A2,2 0 0 1 16,4 L16,6 M10,11 L10,17 M14,11 L14,17"
                                  Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="删除对话"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ==================== 头像浮层菜单 ==================== -->
        <Popup x:Name="AvatarMenu"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <hc:Card Width="222"
                     Margin="10"
                     Padding="8"
                     Effect="{DynamicResource EffectShadow2}">
                <StackPanel>
                    <Grid Margin="6,4,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.6">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C9BF7" Offset="0" />
                                        <GradientStop Color="#3B5BDB" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="30" Height="30">
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="6.6"
                                             Width="9" Height="9" Fill="#FFFFFF" Opacity="0.95" />
                                    <Path Fill="#FFFFFF" Opacity="0.95"
                                          Data="M15,17.4 C10.3,17.4 6.7,20.3 5.9,24.5 L24.1,24.5 C23.3,20.3 19.7,17.4 15,17.4 Z" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="本地用户" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <hc:Divider Margin="0,2,0,4" />
                    <Button Content="模型设置"
                            Style="{StaticResource MenuItemButton}"
                            Click="OpenSettingsFromMenu_Click" />
                    <Button Content="技能管理"
                            Style="{StaticResource MenuItemButton}"
                            Click="OpenSkillsFromMenu_Click" />
                </StackPanel>
            </hc:Card>
        </Popup>
    </Grid>
</Window>
