<Window x:Class="MegaAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MegaAgent.App.Converters"
        xmlns:vm="clr-namespace:MegaAgent.App.ViewModels"
        Title="MegaAgent — 智能体对话工作台"
        Height="780" Width="1200"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource Brush.Window}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- 消息气泡 -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="0,5">
                <Border x:Name="Bubble"
                        MaxWidth="640"
                        Padding="13,10"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush.AssistantBubble}">
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Foreground="{StaticResource Brush.Text}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Brush.Primary}" />
                    <Setter TargetName="Bubble" Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 会话列表项 -->
        <DataTemplate x:Key="ConversationTemplate" DataType="{x:Type vm:ConversationViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding ModelId}"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧栏 ================= -->
        <Border Grid.Column="0"
                Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 顶部：标题 + 新建对话 -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                    <TextBlock Text="MegaAgent"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="MAF + DeepSeek 智能体工作台"
                               Margin="0,3,0,0"
                               Style="{StaticResource HintText}" />
                    <Button Content="＋  新建对话"
                            Margin="0,16,0,0"
                            Command="{Binding NewConversationCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>

                <!-- 底部：用户 / 设置入口 -->
                <Button DockPanel.Dock="Bottom"
                        Margin="8,8,8,12"
                        Padding="10,9"
                        Cursor="Hand"
                        Command="{Binding OpenSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#E5E7EB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource Brush.Primary}">
                            <TextBlock Text="我" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="模型设置" Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 会话列表 -->
                <ListBox ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                         ItemTemplate="{StaticResource ConversationTemplate}"
                         ItemContainerStyle="{StaticResource ConversationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,6,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除对话"
                                      Command="{Binding PlacementTarget.DataContext.DeleteConversationCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= 右侧聊天区 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏：模型 / 技能 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="模型" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <ComboBox Width="170" Margin="8,0,0,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding CurrentConversation.ModelId, Mode=TwoWay}"
                              IsEnabled="{Binding HasCurrentConversation}" />

                    <TextBlock Text="技能" Margin="20,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <ComboBox Width="170" Margin="8,0,0,0"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding SkillOptions}"
                              SelectedItem="{Binding SelectedSkillOption, Mode=TwoWay}"
                              IsEnabled="{Binding HasCurrentConversation}" />

                    <Button Content="技能管理"
                            Margin="10,0,0,0"
                            Command="{Binding ManageSkillsCommand}"
                            Style="{StaticResource SecondaryButton}" />

                    <TextBlock Text="生成中…" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Primary}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- 消息区 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="22,14">
                    <ItemsControl ItemsSource="{Binding CurrentConversation.Messages}"
                                  ItemTemplate="{StaticResource MessageTemplate}" />
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CurrentConversation.Messages.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="开始新对话，或从左侧选择一个历史会话"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>

                <!-- 无会话状态 -->
                <TextBlock Text="点击左侧「＋ 新建对话」开始"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Visibility="{Binding CurrentConversation, Converter={StaticResource NullToVis}}" />
            </Grid>

            <!-- 输入区 -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Background="White">
                        <TextBox x:Name="InputBox"
                                 Text="{Binding DraftInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 IsEnabled="{Binding HasCurrentConversation}"
                                 KeyDown="InputBox_KeyDown" />
                    </Border>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Enter 发送 · Shift+Enter 换行"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HintText}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="停止"
                                    Margin="0,0,8,0"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Content="发送"
                                    Command="{Binding SendMessageCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
