<Window x:Class="MegaAgent.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="模型设置"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">
    <hc:Card Margin="18" Padding="4">
        <StackPanel Margin="6,4,6,6">
            <TextBlock Text="模型设置" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="配置保存在 %APPDATA%\MegaAgent\config.json"
                       Margin="0,6,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <TextBlock Text="API Key" Style="{StaticResource FormLabel}" />
            <hc:PasswordBox x:Name="ApiKeyBox"
                            hc:InfoElement.Placeholder="sk-..." />

            <TextBlock Text="接口地址（OpenAI 兼容端点）" Style="{StaticResource FormLabel}" />
            <hc:TextBox x:Name="EndpointBox" hc:InfoElement.Placeholder="https://api.deepseek.com/v1" />

            <TextBlock Text="默认模型" Style="{StaticResource FormLabel}" />
            <hc:ComboBox x:Name="ModelCombo" Style="{StaticResource ComboBoxExtend}" />

            <TextBlock x:Name="StatusText"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource HintText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Margin="0,0,8,0"
                        Style="{StaticResource ButtonDefault}"
                        Click="TestButton_Click" />
                <Button Content="保存"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        Style="{StaticResource ButtonPrimary}"
                        Click="SaveButton_Click" />
                <Button Content="取消"
                        Style="{StaticResource ButtonDefault}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </hc:Card>
</Window>
