<Window x:Class="MegaAgent.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:MegaAgent.App"
        Title="模型设置"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        Background="{DynamicResource BackgroundBrush}">
    <hc:Card Margin="18" Padding="4">
        <StackPanel Margin="6,4,6,6">
            <TextBlock Text="模型设置" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="配置保存在 %APPDATA%\MegaAgent\config.json"
                       Margin="0,6,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- API Key（必填） -->
            <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="API Key" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:PasswordBox x:Name="ApiKeyBox"
                            local:PasswordBinding.Password="{Binding ApiKey, Mode=TwoWay}"
                            local:RequiredBorder.HasError="{Binding ApiKeyHasError}"
                            hc:InfoElement.Placeholder="sk-..." />
            <TextBlock Text="API Key为必填项"
                       Style="{StaticResource FieldError}"
                       Visibility="{Binding ApiKeyHasError, Converter={StaticResource BoolToVis}}" />

            <!-- 接口地址（必填） -->
            <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="接口地址（OpenAI 兼容端点）" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <hc:TextBox x:Name="EndpointBox"
                        Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        local:RequiredBorder.HasError="{Binding EndpointHasError}"
                        hc:InfoElement.Placeholder="https://api.deepseek.com/v1" />
            <TextBlock Text="接口地址为必填项"
                       Style="{StaticResource FieldError}"
                       Visibility="{Binding EndpointHasError, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="默认模型" Style="{StaticResource FormLabel}" />
            <hc:ComboBox x:Name="ModelCombo"
                         ItemsSource="{Binding AvailableModels}"
                         SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                         Style="{StaticResource ComboBoxExtend}" />

            <TextBlock Text="{Binding StatusText}"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource HintText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Margin="0,0,8,0"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding TestConnectionCommand}" />
                <Button Content="保存"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}" />
                <Button Content="取消"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </hc:Card>
</Window>
