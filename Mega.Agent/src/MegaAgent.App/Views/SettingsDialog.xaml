<Window x:Class="MegaAgent.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型设置"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource Brush.Window}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="DeepSeek 接入配置" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="API Key 与默认模型保存在 %APPDATA%\MegaAgent\config.json"
                   Margin="0,6,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap" />

        <TextBlock Text="API Key" Style="{StaticResource FormLabel}" />
        <PasswordBox x:Name="ApiKeyBox"
                     Padding="8,6"
                     BorderBrush="{StaticResource Brush.Border}"
                     BorderThickness="1" />

        <TextBlock Text="接口地址（OpenAI 兼容端点）" Style="{StaticResource FormLabel}" />
        <TextBox x:Name="EndpointBox" Style="{StaticResource FormInput}" />

        <TextBlock Text="默认模型" Style="{StaticResource FormLabel}" />
        <ComboBox x:Name="ModelCombo"
                  Padding="8,6"
                  VerticalContentAlignment="Center" />

        <TextBlock x:Name="StatusText"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource HintText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="TestButton"
                    Content="测试连接"
                    Margin="0,0,8,0"
                    Click="TestButton_Click"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="保存"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButton}" />
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
