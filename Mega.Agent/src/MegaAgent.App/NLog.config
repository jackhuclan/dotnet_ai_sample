<?xml version="1.0" encoding="utf-8"?>
<!--
  MegaAgent 日志配置（NLog 6.x）
  ------------------------------------------------------------------
  输出位置：<应用目录>\MegaAgent\logs\        （与 config.json 同级的应用数据目录，
                                              即 MegaAgent.Core 的 LogPaths.Directory）
    - megaagent-YYYY-MM-DD.log        全量日志（Debug 及以上）
    - megaagent-error-YYYY-MM-DD.log  错误日志（Error 及以上，便于快速定位）
    - nlog-internal.log               NLog 自身的诊断日志（配置写错时看这里）
  落盘策略：AsyncWrapper 异步 + 单文件超过 5MB 自动归档，最多保留 10 个归档。
  修改本文件无需重启应用即可生效（autoReload="true"）。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/MegaAgent/logs/nlog-internal.log">

  <!-- 必须用 ${basedir} 而非相对路径：相对路径会按进程工作目录解析，
       导致日志落到 exe 目录之外（例如从仓库根目录启动时污染源码树） -->
  <variable name="logDir" value="${basedir}/MegaAgent/logs" />
  <!-- 统一行格式：时间 | 级别 | 类名 | 消息（异常单独换行展开） -->
  <variable name="commonLayout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:|${newline}${exception:format=ToString,Data}}" />

  <targets>
    <!-- 全量日志：按天分文件，单文件超 5MB 归档，最多保留 10 个 -->
    <target xsi:type="AsyncWrapper" name="asyncFile"
            queueLimit="10000" overflowAction="Discard" batchSize="100" timeToSleepBetweenBatches="50">
      <target xsi:type="File" name="file"
              fileName="${logDir}/megaagent-${shortdate}.log"
              layout="${commonLayout}"
              encoding="utf-8"
              keepFileOpen="true"
              archiveAboveSize="5242880"
              maxArchiveFiles="10"
              maxArchiveDays="30"
              archiveSuffixFormat="-{0:yyyyMMdd-HHmmss}.log" />
    </target>

    <!-- 错误日志：单独一份，排查故障时只看这个文件即可 -->
    <target xsi:type="AsyncWrapper" name="asyncErrorFile"
            queueLimit="10000" overflowAction="Discard" batchSize="20" timeToSleepBetweenBatches="50">
      <target xsi:type="File" name="errorFile"
              fileName="${logDir}/megaagent-error-${shortdate}.log"
              layout="${commonLayout}"
              encoding="utf-8"
              keepFileOpen="true"
              maxArchiveFiles="30"
              maxArchiveDays="90" />
    </target>

    <!-- 开发期：同时输出到 Visual Studio / DebugView 的输出窗口 -->
    <target xsi:type="Debugger" name="debugger" layout="${commonLayout}" />
  </targets>

  <rules>
    <!-- 降噪必须放在最前面：final="true" 表示命中后不再走后续规则，
         Hosting / DI / HttpClient 的 Debug、Info 直接丢弃，只保留 Warning 及以上 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- 业务代码的日志：全量落盘 + 错误单列 + 调试窗口 -->
    <logger name="*" minlevel="Debug" writeTo="asyncFile" />
    <logger name="*" minlevel="Error" writeTo="asyncErrorFile" />
    <logger name="*" minlevel="Debug" writeTo="debugger" />
  </rules>
</nlog>
